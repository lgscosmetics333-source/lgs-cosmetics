# Reference for the ONE Hostinger website's Environment variables screen.
# Do not commit real values. Local backend development uses backend/.env.
NODE_ENV=production
DB_HOST=YOUR_MYSQL_HOST
DB_PORT=3306
DB_NAME=YOUR_DATABASE_NAME
DB_USER=YOUR_DATABASE_USER
DB_PASSWORD=YOUR_DATABASE_PASSWORD
JWT_SECRET=YOUR_RANDOM_ADMIN_SECRET_AT_LEAST_32_CHARACTERS
CUSTOMER_AUTH_SECRET=YOUR_DIFFERENT_RANDOM_AUTH_SECRET_AT_LEAST_32_CHARACTERS
FRONTEND_URL=https://lgscosmetics.com
CUSTOMER_AUTH_URL=https://lgscosmetics.com
# Set to an absolute persistent directory provided by your hosting account.
# UPLOAD_DIR=/your-persistent-directory/lgs-uploads
RAZORPAY_ENABLED=false
RESEND_ENABLED=false
RESEND_DOMAIN_VERIFIED=false
EKART_ENABLED=false
# Set this to the site's public origin only when Ekart is enabled.
EKART_PUBLIC_BACKEND_URL=https://lgscosmetics.com
